{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "nestjs",
      "entrypoint": "src/main.ts"
    },
    "frontend": {
      "root": "frontend",
      "framework": "angular",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/users/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/users",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/posts/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/posts",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
